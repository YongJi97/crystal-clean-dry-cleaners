# Square (sandbox values shown — swap for production when going live)
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Optional: catalog ITEM_VARIATION id for "$0 Pickup Request" (cleaner tickets/reporting)
SQUARE_PICKUP_VARIATION_ID=
SQUARE_VERSION=2025-01-16

# Optional: Formspree webhook signing secret from the Webhook plugin settings
FORMSPREE_WEBHOOK_SECRET=
