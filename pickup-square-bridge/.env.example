# Square (sandbox values shown — swap for production when going live)
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Optional: catalog ITEM_VARIATION id for "$0 Pickup Request" (cleaner tickets/reporting)
SQUARE_PICKUP_VARIATION_ID=
SQUARE_VERSION=2025-01-16

# Optional: Formspree webhook signing secret from the Webhook plugin settings.
# If you set this, unsigned browser posts are rejected. Leave empty for the
# site's dual-submit (the page posts JSON here directly).
FORMSPREE_WEBHOOK_SECRET=

# Shared key for non-browser clients (the iOS app, curl, a Formspree webhook).
# Send it as the X-App-Key header. When this is set, a request with no Origin
# — or an Origin other than the site hosts — must include the key. Requests
# whose Origin is https://crystalcleandrycleaner.com or
# https://www.crystalcleandrycleaner.com keep working without it, so the
# public pickup form is unchanged. Leave empty to keep the previous open webhook.
APP_API_KEY=

# Optional override. Defaults to the two hosts above.
# ALLOWED_ORIGINS=https://crystalcleandrycleaner.com,https://www.crystalcleandrycleaner.com
